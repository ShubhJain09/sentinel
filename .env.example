# ==============================================================================
# SENTINEL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Never commit real credentials or private keys to source control.
# ==============================================================================

# ── 1. Core Application & Database ─────────────────────────────────────────────
# Secret used to sign and verify HMAC-SHA256 session JWTs (minimum 32 characters)
JWT_SECRET=your-random-32-char-jwt-secret-string-here

# SQLite database file path (relative to project root or absolute)
DATABASE_PATH=./sentinel.db

# Public-facing application URL (used in email links, OAuth callbacks, and redirect validation)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 2. Access Control & Owner Designation ──────────────────────────────────────
# Comma-separated list of emails granted permanent OWNER role in Sentinel
OWNER_EMAIL=owner@sentinel.security,admin@sentinel.security

# ── 3. Transactional Email Delivery ───────────────────────────────────────────
# Default "From" address used across all outgoing notification and security emails
EMAIL_FROM="Sentinel Security <security@sentinel.security>"

# Resend API Key (active transactional email provider)
# If provided, Sentinel will prioritize Resend over SMTP/local outbox
RESEND_API_KEY=re_your_resend_api_key_here

# Alternative Provider: Postmark Server Token
# POSTMARK_SERVER_TOKEN=your-postmark-server-token

# Alternative Provider: Standard SMTP Relay
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false

# ── 4. OAuth & Identity Federation ─────────────────────────────────────────────
# Google OAuth 2.0 Credentials (for "Continue with Google")
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign-In Credentials (optional)
# APPLE_CLIENT_ID=com.sentinel.security.client
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_KEY_ID=YOUR_KEY_ID
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── 5. AI Security Providers & Inference Engines ──────────────────────────────
# TrueForge / TrueFoundry Agent Security Platform
# TRUEFORGE_API_KEY=your-trueforge-api-key

# Groq High-Throughput LPU Inference Engine
# GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI API Key (optional LLM analysis backend)
# OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (optional Claude security reasoning)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google Gemini API Key (optional Gemini security reasoning)
# GEMINI_API_KEY=your-gemini-api-key
